# Password that unlocks the presentation (/). The audience page (/join) stays public.
PRESENTER_PASSWORD=change-me

# Optional: override the URL encoded in the QR code (e.g. your tunnel or LAN address)
# NEXT_PUBLIC_JOIN_URL=https://your-domain.example/join


# Optional: shared storage for serverless hosting (Vercel). Without it an in-memory store is used,
# which is perfect for `pnpm build && pnpm start` on one machine (optionally behind a tunnel).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
